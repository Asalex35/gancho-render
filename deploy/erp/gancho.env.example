# /etc/gancho/gancho.env  (dueño root, grupo gancho, permisos 640). Sin comillas y sin comentarios al final de
# una línea (systemd los tomaría como parte del valor). Los valores reales SOLO viven en ese archivo:
# nunca en git, en el chat ni en archivos temporales. Las llaves las pega Luis.
NODE_ENV=production
HOST=127.0.0.1
PORT=8090
PUBLIC_BASE_URL=https://portadas.erp-prismaticoos.com
# Nombre en pantalla (el ERP lo muestra en Prisma Studio › Kit de publicación)
APP_NOMBRE=Kit de publicación
APP_SUBTITULO=Prisma Studio

# ---------- Base de datos (base y usuario PROPIOS: gancho, no la del ERP) ----------
# Producción: clúster administrado erp-db-produccion por la VPC con TLS verificado.
DATABASE_URL=postgresql://gancho:<CONTRASEÑA>@private-<HOST>.db.ondigitalocean.com:25060/gancho?sslmode=verify-full&sslrootcert=/etc/erp/do-ca-produccion.crt
# Pruebas (PostgreSQL local por socket, sin contraseña):
# DATABASE_URL=postgresql:///gancho?host=/var/run/postgresql

# ---------- Secretos propios (generar con: openssl rand -hex 32) ----------
SESSION_SECRET=
LINK_SECRET=
CALLBACK_SECRET=

# ---------- Conexión con el ERP (módulo Portadas) ----------
# = GANCHO_SSO_SECRET en /etc/erp/erp.env
ERP_SSO_SECRET=
# solo se entra desde el ERP
ERP_SOLO=1
ERP_DOMINIO=prismaticoos.com
ERP_BITACORA_URL=https://sistema.erp-prismaticoos.com/api/portadas/bitacora
# = GANCHO_BITACORA_SECRET en /etc/erp/erp.env
ERP_BITACORA_SECRET=
# Service token de Cloudflare Access (Zero Trust → Access → Service Auth) con permiso SOLO a /api/portadas/bitacora del ERP
ERP_BITACORA_CF_ID=
ERP_BITACORA_CF_SECRET=
# regla del ERP: más de US$5 de una vez lo lanza un administrador
ERP_LIMITE_USD=5
# acceso de emergencia (debe pasar Cloudflare Access con su correo)
ADMIN_USER=luis.solis
# mínimo 10 caracteres
ADMIN_PASSWORD=

# ---------- Cloudflare Access (Zero Trust → Access → Applications → la de portadas) ----------
# el team domain sin .cloudflareaccess.com
CF_ACCESS_TEAM=
# Application Audience (AUD) Tag
CF_ACCESS_AUD=

# ---------- IA ----------
ANTHROPIC_API_KEY=
# Google AI Studio / Cloud: Generative Language API con facturación activa
GOOGLE_API_KEY=
# orden: si uno falla, pasa al siguiente
IMAGE_PROVIDERS=google,nanobanana,fal
# respaldo (opcional)
NANOBANANA_API_KEY=
# respaldo final (opcional)
FAL_KEY=
# transcripción de los videos
ELEVENLABS_API_KEY=
# vista previa «Cómo se ve en YouTube» (gratis, 10,000 unidades/día)
YOUTUBE_API_KEY=

# ---------- Archivos: DigitalOcean Spaces (recomendado; videos de hasta 30 GB) ----------
S3_BUCKET=prismaticoos-gancho-prod
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_REGION=sfo3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Sin Spaces: disco local (necesita espacio para los videos mientras se leen)
DATA_DIR=/var/lib/gancho/datos
MAX_VIDEO_GB=30

# ---------- Retención (días) ----------
VIDEO_RETENTION_DAYS=3
# RETENCION_TEXTO_DIAS=7  RETENCION_CUADROS_DIAS=14  RETENCION_ARCHIVADAS_DIAS=30  RETENCION_ANTERIORES_DIAS=30  RETENCION_NO_ELEGIDAS_DIAS=60

# ---------- Avisos (opcional): Slack, Google Chat o Discord ----------
NOTIFY_WEBHOOK_URL=
