+import type { ErpModule } from "../../core/modulos.js";
+import { permisosPortadas } from "./permisos.js";
+import { actividadPortadas } from "./actividad.js";
+import { rutasPortadas } from "./rutas.js";
+import { configGancho } from "./gancho.js";
+
+/**
+ * Ventanilla del módulo Portadas (Social Media › Portadas): PUENTE hacia Gancho, la herramienta de portadas, títulos y
+ * descripciones de YouTube, TikTok, Instagram, Facebook y Prisma Plus que vive en su propio subdominio. No tiene tablas:
+ * arma el inicio único (SSO) hacia Gancho y recibe, firmada, la bitácora de lo que se hace allá.
+ * Variables GANCHO_URL, GANCHO_SSO_SECRET y GANCHO_BITACORA_SECRET (gancho.ts; docs/portadas/README.md). Sin ellas el
+ * módulo queda encendido pero responde 503 «Portadas aún no está conectado…», así que no va en `apagadosFueraDeLocal`.
+ */
+export const portadas: ErpModule = {
+  clave: "portadas",
+  nombre: "Portadas",
+  permisos: permisosPortadas,
+  /** Bitácora de actividad: abrir Gancho desde el ERP y lo que Gancho reporta (portadas, versiones, lotes…). */
+  actividad: { eventos: actividadPortadas.eventos },
+  rutas: rutasPortadas,
+  /** /api/health: si este servidor está conectado con Gancho (sin URLs ni llaves). */
+  salud: () => {
+    const c = configGancho();
+    return { portadas: { conectado: !!(c.url && c.ssoSecreto), bitacora: !!c.bitacoraSecreto } };
+  },
+};
