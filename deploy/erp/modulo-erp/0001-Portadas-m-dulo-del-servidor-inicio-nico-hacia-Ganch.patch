+import type { Accion, PermisosModulo } from "../../core/permisos/arbol.js";
+import { puede, type Permisos } from "../../core/permisos/service.js";
+
+/**
+ * Permisos de Portadas (puente hacia Gancho, la herramienta de portadas que vive en su propio subdominio).
+ * ver = ver la pantalla; crear = abrir Gancho y trabajar ahí (portadas, títulos y versiones); aprobar = entrar a Gancho
+ * como administrador (ve lo de todo el equipo y puede lanzar trabajos de más de US$5).
+ */
+export const PORTADAS = "portadas";
+
+const TODAS: Accion[] = ["ver", "crear", "aprobar"];
+
+export const permisosPortadas: PermisosModulo = {
+  arbol: {
+    clave: PORTADAS,
+    nombre: "Portadas (Gancho)",
+    descripcion: "Portadas, títulos y descripciones de cada red social y de Prisma Plus con Gancho (herramienta aparte).",
+    acciones: TODAS,
+    ayudaAcciones: {
+      crear: "Generar portadas, títulos y versiones",
+      aprobar: "Administrar Gancho: ver lo de todo el equipo y lanzar trabajos de más de US$5",
+    },
+  },
+  // Módulo nuevo (oct-2026): no hubo niveles anteriores; la equivalencia es para scripts y pruebas que hablan en niveles.
+  legado: {
+    ver: { nodos: { [PORTADAS]: { acciones: ["ver"] } }, capacidades: [] },
+    editar: { nodos: { [PORTADAS]: { acciones: ["ver", "crear"] } }, capacidades: [] },
+    administrar: { nodos: { [PORTADAS]: { acciones: TODAS } }, capacidades: [] },
+  },
+};
+
+/** Rol con el que la persona entra a Gancho: «admin» con Portadas › Aprobar (o superadministrador); si no, «editor». */
+export const rolEnGancho = (p: Permisos): "admin" | "editor" => (p.superadmin || puede(p, PORTADAS, "aprobar") ? "admin" : "editor");
diff --git a/server/src/modules/portadas/rutas.ts b/server/src/modules/portadas/rutas.ts
new file mode 100644
index 0000000..34726da
--- /dev/null
+++ b/server/src/modules/portadas/rutas.ts
@@ -0,0 +1,68 @@
+import type { FastifyInstance } from "fastify";
+import { audit } from "../../core/auditoria/audit.js";
+import { DOMINIO_PERMITIDO, esDominioPermitido } from "../../core/cloudflare/acceso.js";
+import { usuariosBasicos } from "../../core/usuarios.js";
+import { actividadPortadas } from "./actividad.js";
+import { PORTADAS, rolEnGancho } from "./permisos.js";
+import { MAX_CUERPO_BITACORA, NO_CONECTADO, aTiempo, configGancho, firmaBitacoraValida, tokenPara, yaRecibida } from "./gancho.js";
+import { correoDe, hechoDe, leerEvento } from "./bitacora.js";
+
+/**
+ * API de Portadas (puente hacia Gancho):
+ * - GET  /api/portadas/estado     (Portadas › Ver): ¿está conectado este servidor con Gancho?
+ * - POST /api/portadas/entrar     (Portadas › Crear): arma el inicio único y devuelve la URL de Gancho.
+ * - POST /api/portadas/bitacora   (público, firmado): Gancho manda cada acción para la bitácora de actividad del ERP.
+ */
+export async function rutasPortadas(app: FastifyInstance) {
+  app.get("/api/portadas/estado", { config: { permiso: [PORTADAS, "ver"] } }, async () => {
+    const c = configGancho();
+    return c.url && c.ssoSecreto ? { conectado: true, url: c.url } : { conectado: false };
+  });
+
+  app.post("/api/portadas/entrar", { config: { permiso: [PORTADAS, "crear"], rateLimit: { max: 20, timeWindow: "1 minute" } } }, async (req, reply) => {
+    const c = configGancho();
+    if (!c.url || !c.ssoSecreto) return reply.code(503).send({ error: NO_CONECTADO });
+    const u = req.usuario!;
+    // Gancho solo acepta cuentas de la empresa (y el ERP solo da de alta esas): se dice claro antes de mandar a la persona.
+    if (!esDominioPermitido(u.email)) return reply.code(403).send({ error: `Solo las cuentas @${DOMINIO_PERMITIDO} pueden entrar a Portadas.` });
+    const rol = rolEnGancho(u.permisos);
+    const token = tokenPara({ email: u.email, nombre: u.name, rol }, c.ssoSecreto);
+    await audit("portadas.entrar", req, u.id, { rol });
+    await actividadPortadas.registrar("abrir", { usuario: u.id, datos: { rol } });
+    return { url: `${c.url}/sso?t=${encodeURIComponent(token)}` };
+  });
+
+  // La bitácora necesita el cuerpo CRUDO exacto para revisar la firma: un contexto aparte con su propio lector de JSON
+  // (entrega el texto tal cual) que solo aplica a esta ruta.
+  await app.register(async (gancho) => {
+    gancho.removeContentTypeParser("application/json");
+    gancho.addContentTypeParser("application/json", { parseAs: "string", bodyLimit: MAX_CUERPO_BITACORA }, (_req, cuerpo, listo) => listo(null, cuerpo));
+
+    gancho.post("/api/portadas/bitacora", {
+      bodyLimit: MAX_CUERPO_BITACORA,
+      // Una sola IP (el servidor de Gancho) manda todo el equipo: tope más alto que el general sin sesión.
+      config: { acceso: "publico", rateLimit: { max: 600, timeWindow: "1 minute" } },
+    }, async (req, reply) => {
+      const secreto = configGancho().bitacoraSecreto;
+      if (!secreto) return reply.code(503).send({ error: NO_CONECTADO });
+      const crudo = typeof req.body === "string" ? req.body : "";
+      const firma = req.headers["x-gancho-firma"];
+      if (!firmaBitacoraValida(crudo, firma, secreto)) return reply.code(401).send({ error: "Firma no válida." });
+      let cuerpo: unknown;
+      try { cuerpo = JSON.parse(crudo); } catch { return reply.code(400).send({ error: "El cuerpo no es JSON." }); }
+      const ev = leerEvento(cuerpo);
+      if (!ev) return reply.code(400).send({ error: "No es un evento de Gancho." });
+      if (!aTiempo(ev.cuando)) return reply.code(401).send({ error: "El evento está fuera de tiempo (más de 5 minutos de diferencia)." });
+      // Un reintento con la misma firma no se cuenta dos veces.
+      if (yaRecibida(String(firma))) return { ok: true, repetido: true };
+
+      // Quién: por correo, con la ventanilla de usuarios del núcleo (nunca la tabla users directo). Si no está en el ERP,
+      // el hecho queda sin usuario (como una tarea automática).
+      const correo = correoDe(ev, DOMINIO_PERMITIDO);
+      const usuario = correo ? (await usuariosBasicos()).find((x) => x.email.trim().toLowerCase() === correo)?.id ?? null : null;
+      const h = hechoDe(ev);
+      const r = await actividadPortadas.registrar(h.tipo, { usuario, objeto: h.objeto, cantidad: h.cantidad, datos: h.datos });
+      return { ok: true, registrado: r.ok, tipo: h.tipo, usuario: usuario !== null };
+    });
+  });
+}
