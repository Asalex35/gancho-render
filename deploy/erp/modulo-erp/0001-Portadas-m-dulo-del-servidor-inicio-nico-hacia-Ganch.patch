@@ -0,0 +1,122 @@
+import type { DatosActividad } from "../../core/actividad/index.js";
+import type { TipoDeGancho } from "./actividad.js";
+
+/**
+ * Traducción de lo que manda Gancho a la bitácora de actividad del ERP. Lógica pura.
+ *
+ * Gancho manda `{ modulo: "gancho", usuario, email?, accion, detalle, ip, cuando }` (src/erp.js de Gancho, `registrar`).
+ * De `detalle` SOLO se toman ids (episodio, propuesta), conteos y el costo estimado en dólares (`usd`): nunca prompts,
+ * títulos, comentarios, razones ni nombres de personas. La IP no se guarda en la actividad (la bitácora no la acepta).
+ */
+export const ACCIONES_GANCHO: Readonly<Record<string, TipoDeGancho>> = {
+  entrar: "entrada",
+  generar: "portadas_generadas",
+  // Así la llama hoy Gancho (web.js): «generar_propuestas» de un episodio.
+  generar_propuestas: "portadas_generadas",
+  rehacer: "portada_rehecha",
+  ajustar: "portada_ajustada",
+  crear_versiones: "versiones_creadas",
+  lote_lanzado: "lote_lanzado",
+  borrar_episodio: "episodio_borrado",
+  corregir_corte_hack: "corte_corregido",
+};
+
+/** Objeto de cada tipo (el mismo que declara el catálogo en actividad.ts). */
+const OBJETO: Record<TipoDeGancho, "gancho" | "episodio" | "portada" | "lote"> = {
+  entrada: "gancho", portadas_generadas: "episodio", portada_rehecha: "portada", portada_ajustada: "portada",
+  versiones_creadas: "portada", lote_lanzado: "lote", episodio_borrado: "episodio", corte_corregido: "episodio", otra_accion: "gancho",
+};
+
+export type EventoGancho = { modulo: "gancho"; usuario: string | null; email: string | null; accion: string; detalle: Record<string, unknown>; cuando: string };
+
+export type HechoGancho = {
+  tipo: TipoDeGancho;
+  objeto?: { tipo: string; id: string };
+  cantidad?: number;
+  datos: DatosActividad;
+};
+
+const ID = /^[A-Za-z0-9_-]{1,64}$/;
+const idDe = (v: unknown): string | null => {
+  const s = typeof v === "number" && Number.isInteger(v) && v >= 0 ? String(v) : typeof v === "string" ? v.trim() : "";
+  return ID.test(s) ? s : null;
+};
+const conteo = (v: unknown): number | null => (typeof v === "number" && Number.isInteger(v) && v >= 0 && v <= 100_000 ? v : null);
+const dolares = (v: unknown): number | null => (typeof v === "number" && Number.isFinite(v) && v >= 0 && v <= 100_000 ? Math.round(v * 100) / 100 : null);
+
+/** Valida la forma del evento (ya con la firma revisada). null = no es un evento de Gancho. */
+export function leerEvento(cuerpo: unknown): EventoGancho | null {
+  if (!cuerpo || typeof cuerpo !== "object" || Array.isArray(cuerpo)) return null;
+  const c = cuerpo as Record<string, unknown>;
+  if (c.modulo !== "gancho" || typeof c.accion !== "string" || !c.accion.trim() || c.accion.length > 80 || typeof c.cuando !== "string") return null;
+  const detalle = c.detalle && typeof c.detalle === "object" && !Array.isArray(c.detalle) ? (c.detalle as Record<string, unknown>) : {};
+  return {
+    modulo: "gancho",
+    usuario: typeof c.usuario === "string" ? c.usuario.trim().slice(0, 80) : null,
+    email: typeof c.email === "string" ? c.email.trim().toLowerCase().slice(0, 200) : null,
+    accion: c.accion.trim(),
+    detalle,
+    cuando: c.cuando,
+  };
+}
+
+/**
+ * Correo del ERP de quien hizo la acción: el `email` que manda Gancho o, si no viene (versiones de Gancho que solo
+ * mandan su usuario, que es la parte antes de la @), `usuario@dominio`. Solo del dominio de la empresa.
+ */
+export function correoDe(ev: EventoGancho, dominio: string): string | null {
+  const sufijo = `@${dominio}`;
+  if (ev.email) return ev.email.endsWith(sufijo) && ev.email.length > sufijo.length ? ev.email : null;
+  const u = (ev.usuario ?? "").toLowerCase();
+  if (!/^[a-z0-9._-]{2,40}$/.test(u) || u === "sistema") return null;
+  return `${u}${sufijo}`;
+}
+
+/** El hecho de la bitácora que corresponde a un evento de Gancho (tipo, objeto, cantidad y datos acotados). */
+export function hechoDe(ev: EventoGancho): HechoGancho {
+  const tipo: TipoDeGancho = ACCIONES_GANCHO[ev.accion] ?? "otra_accion";
+  const d = ev.detalle;
+  const datos: DatosActividad = {};
+  let id: string | null = null;
+  let cantidad: number | null = null;
+
+  switch (tipo) {
+    case "portadas_generadas":
+      id = idDe(d.episodio);
+      cantidad = conteo(d.cantidad) ?? conteo(d.portadas) ?? (Array.isArray(d.propuestas) ? d.propuestas.length : null);
+      break;
+    case "portada_rehecha":
+    case "portada_ajustada":
+      id = idDe(d.propuesta) ?? idDe(d.portada);
+      break;
+    case "versiones_creadas":
+      id = idDe(d.propuesta) ?? idDe(d.portada);
+      cantidad = conteo(d.cantidad) ?? (Array.isArray(d.tipos) ? d.tipos.length : null);
+      break;
+    case "lote_lanzado":
+      id = idDe(d.lote);
+      cantidad = conteo(d.episodios) ?? conteo(d.cantidad);
+      break;
+    case "episodio_borrado":
+    case "corte_corregido":
+      id = idDe(d.episodio);
+      break;
+    case "otra_accion":
+      datos.accion = /^[a-z][a-z0-9_]{0,39}$/.test(ev.accion) ? ev.accion : "desconocida";
+      break;
+    case "entrada":
+      break;
+  }
+  // El episodio también va en datos cuando el objeto es otro (p. ej. una portada de ese episodio).
+  const episodio = idDe(d.episodio);
+  if (episodio && OBJETO[tipo] !== "episodio") datos.episodio = episodio;
+  const usd = dolares(d.usd);
+  if (usd !== null) datos.usd = usd;
+
+  return {
+    tipo,
+    ...(id ? { objeto: { tipo: OBJETO[tipo], id } } : {}),
+    ...(cantidad !== null ? { cantidad } : {}),
+    datos,
+  };
+}
diff --git a/server/src/modules/portadas/gancho.ts b/server/src/modules/portadas/gancho.ts
