+++ b/server/src/modules/portadas/gancho.ts
@@ -0,0 +1,105 @@
+import { createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+
+/**
+ * Conexión con GANCHO (herramienta de portadas en su propio subdominio, p. ej. https://portadas.erp-prismaticoos.com).
+ * Lógica pura (sin base ni Fastify) para poder probarla sola.
+ *
+ * VARIABLES DE ENTORNO (se leen aquí con process.env y no en core/config, que es del núcleo; ver docs/portadas/README.md):
+ * - GANCHO_URL: dirección de Gancho (https; http solo para localhost o *.local en desarrollo).
+ * - GANCHO_SSO_SECRET: llave compartida del inicio único (en Gancho se llama ERP_SSO_SECRET). Mínimo 32 caracteres.
+ * - GANCHO_BITACORA_SECRET: llave con la que Gancho firma lo que manda a la bitácora (en Gancho, ERP_BITACORA_SECRET).
+ *   Mínimo 32 caracteres.
+ * Sin GANCHO_URL o GANCHO_SSO_SECRET, Portadas responde 503 con un mensaje amable (no hace falta apagar el módulo).
+ */
+export const NO_CONECTADO = "Portadas aún no está conectado en este servidor. Pídeselo a Luis.";
+export const MIN_SECRETO = 32;
+
+export type ConfigGancho = { url: string | null; ssoSecreto: string | null; bitacoraSecreto: string | null };
+
+/** https://… (sin diagonal final); http solo para la red local. Cualquier otra cosa = sin configurar. */
+export function urlGancho(valor: string | undefined): string | null {
+  const v = (valor ?? "").trim().replace(/\/+$/, "");
+  if (!v) return null;
+  try {
+    const u = new URL(v);
+    const local = u.hostname === "localhost" || u.hostname === "127.0.0.1" || u.hostname.endsWith(".local");
+    if (u.protocol !== "https:" && !(u.protocol === "http:" && local)) return null;
+    if (u.username || u.password || u.search || u.hash) return null;
+    return `${u.origin}${u.pathname === "/" ? "" : u.pathname.replace(/\/+$/, "")}`;
+  } catch {
+    return null;
+  }
+}
+
+const secreto = (v: string | undefined) => {
+  const s = (v ?? "").trim();
+  return s.length >= MIN_SECRETO ? s : null;
+};
+
+/** Lee la configuración en cada petición (así Luis la cambia en erp.env y basta reiniciar; las pruebas la cambian sola). */
+export function configGancho(env: NodeJS.ProcessEnv = process.env): ConfigGancho {
+  return { url: urlGancho(env.GANCHO_URL), ssoSecreto: secreto(env.GANCHO_SSO_SECRET), bitacoraSecreto: secreto(env.GANCHO_BITACORA_SECRET) };
+}
+
+/* ── Inicio único (SSO) ── */
+
+/** Vida del enlace: Gancho rechaza más de 120 s. */
+export const VIDA_TOKEN_SEG = 90;
+
+export type DatosToken = { email: string; nombre: string; rol: "admin" | "editor"; exp: number; n: string };
+
+/**
+ * Token que Gancho verifica en /sso (src/erp.js de Gancho, `entrarConToken`):
+ * base64url(JSON) + "." + base64url(HMAC-SHA256(secreto, base64url(JSON))). La firma va sobre la PARTE base64url.
+ */
+export function firmarToken(datos: DatosToken, secretoSso: string): string {
+  const parte = Buffer.from(JSON.stringify(datos), "utf8").toString("base64url");
+  const firma = createHmac("sha256", secretoSso).update(parte).digest("base64url");
+  return `${parte}.${firma}`;
+}
+
+/** Arma el token de una persona: vence en VIDA_TOKEN_SEG y lleva un número único de 16 bytes en hex. */
+export function tokenPara(p: { email: string; nombre: string; rol: "admin" | "editor" }, secretoSso: string, ahoraMs = Date.now()): string {
+  return firmarToken({
+    email: p.email.trim().toLowerCase(),
+    nombre: p.nombre.trim().slice(0, 120),
+    rol: p.rol,
+    exp: Math.floor(ahoraMs / 1000) + VIDA_TOKEN_SEG,
+    n: randomBytes(16).toString("hex"),
+  }, secretoSso);
+}
+
+/* ── Bitácora que manda Gancho ── */
+
+/** Tamaño máximo del cuerpo que acepta /api/portadas/bitacora. */
+export const MAX_CUERPO_BITACORA = 32 * 1024;
+/** Diferencia máxima entre `cuando` y el reloj del ERP. */
+export const MAX_DESFASE_MS = 5 * 60 * 1000;
+
+/** Firma de Gancho: HMAC-SHA256 en HEX del cuerpo CRUDO exacto. Comparación en tiempo constante. */
+export function firmaBitacoraValida(cuerpo: string, firma: unknown, secretoBitacora: string): boolean {
+  if (typeof firma !== "string" || !/^[0-9a-f]{64}$/i.test(firma.trim())) return false;
+  const esperada = createHmac("sha256", secretoBitacora).update(cuerpo, "utf8").digest();
+  const recibida = Buffer.from(firma.trim(), "hex");
+  return recibida.length === esperada.length && timingSafeEqual(recibida, esperada);
+}
+
+/** ¿`cuando` (ISO) está dentro de ±5 minutos del reloj del ERP? */
+export function aTiempo(cuando: unknown, ahoraMs = Date.now()): boolean {
+  if (typeof cuando !== "string" || cuando.length > 40) return false;
+  const t = Date.parse(cuando);
+  return Number.isFinite(t) && Math.abs(ahoraMs - t) <= MAX_DESFASE_MS;
+}
+
+/**
+ * Firmas ya recibidas en la ventana de tiempo: un evento repetido (reintento o reenvío) no se cuenta dos veces.
+ * En memoria del proceso: suficiente con una sola API; si algún día hay varias, a lo más se contaría doble un reintento.
+ */
+const vistas = new Map<string, number>();
+export function yaRecibida(firma: string, ahoraMs = Date.now()): boolean {
+  for (const [k, vence] of vistas) if (vence < ahoraMs) vistas.delete(k);
+  const clave = firma.trim().toLowerCase();
+  if (vistas.has(clave)) return true;
+  if (vistas.size < 50_000) vistas.set(clave, ahoraMs + 2 * MAX_DESFASE_MS);
+  return false;
+}
