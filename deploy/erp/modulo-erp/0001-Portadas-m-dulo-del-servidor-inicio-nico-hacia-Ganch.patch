+import { definirActividad } from "../../core/actividad/index.js";
+
+/**
+ * Bitácora de actividad de Portadas (core/actividad). «abrir» lo registra el ERP al armar el inicio único; lo demás lo
+ * manda el servidor de Gancho, firmado, a `POST /api/portadas/bitacora` (ver rutas.ts y bitacora.ts).
+ * En `datos` van SOLO conteos, ids y el costo estimado en dólares (`usd`): nunca prompts, títulos, comentarios ni nombres.
+ */
+export const actividadPortadas = definirActividad("portadas", [
+  { tipo: "abrir", nombre: "Abrió Gancho desde el ERP", descripcion: "La persona pidió entrar a Gancho desde Social Media › Portadas (el ERP armó su inicio único). `datos.rol` = admin o editor.", objeto: "gancho" },
+  { tipo: "entrada", nombre: "Entrada a Gancho", descripcion: "Gancho avisó que la persona inició sesión ahí (desde el ERP o con el usuario de emergencia).", objeto: "gancho" },
+  { tipo: "portadas_generadas", nombre: "Portadas generadas", descripcion: "Gancho generó propuestas de portada para un episodio. La cantidad es el número de portadas, si Gancho la manda.", objeto: "episodio", medida: "cantidad" },
+  { tipo: "portada_rehecha", nombre: "Portada rehecha", descripcion: "Se pidió rehacer una portada propuesta.", objeto: "portada" },
+  { tipo: "portada_ajustada", nombre: "Portada ajustada", descripcion: "Se ajustó una portada propuesta (texto, encuadre o colores).", objeto: "portada" },
+  { tipo: "versiones_creadas", nombre: "Versiones creadas", descripcion: "Se crearon versiones de una portada para otros formatos (YouTube, TikTok, Instagram, Facebook, Prisma Plus). La cantidad es el número de versiones.", objeto: "portada", medida: "cantidad" },
+  { tipo: "lote_lanzado", nombre: "Lote lanzado", descripcion: "Se lanzó un lote de portadas para varios episodios a la vez. La cantidad es el número de episodios; `datos.usd` = costo estimado.", objeto: "lote", medida: "cantidad" },
+  { tipo: "episodio_borrado", nombre: "Episodio borrado", descripcion: "Se borró un episodio de Gancho.", objeto: "episodio" },
+  { tipo: "corte_corregido", nombre: "Corte corregido", descripcion: "Se corrigió el corte del hack (inicio) de un episodio.", objeto: "episodio" },
+  { tipo: "otra_accion", nombre: "Otra acción en Gancho", descripcion: "Una acción de Gancho que este catálogo todavía no conoce (`datos.accion` = su clave).", objeto: "gancho" },
+] as const);
+
+/** Tipos que Gancho puede registrar (todos menos «abrir», que es del ERP). */
+export type TipoDeGancho = Exclude<(typeof actividadPortadas.eventos)[number]["tipo"], "abrir">;
