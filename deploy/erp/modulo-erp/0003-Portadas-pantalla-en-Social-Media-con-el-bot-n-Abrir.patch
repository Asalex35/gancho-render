@@ -0,0 +1,81 @@
+import { useState } from "react";
+import { ExternalLink, PlugZap } from "lucide-react";
+import AppShell from "@/core/layout/AppShell";
+import PageTransition from "@/core/layout/PageTransition";
+import type { MenuItem } from "@/core/menu";
+import { usePermisos } from "@/core/auth/AuthContext";
+import { Aviso, Boton, Esqueleto, Tarjeta } from "@/shared/components/ui";
+import EmptyState from "@/shared/components/EmptyState";
+import { post } from "@/shared/lib/api";
+import { avisar } from "@/shared/lib/avisos";
+import { useLectura } from "@/shared/lib/cache";
+import { NODO_PORTADAS } from "@/modules/portadas/secciones";
+
+type Estado = { conectado: boolean; url?: string };
+
+const NO_CONECTADO = "Portadas aún no está conectado en este servidor. Pídeselo a Luis.";
+
+/**
+ * Social Media › Portadas: puente hacia Gancho. El botón pide al ERP un enlace de inicio único (vale 90 s y una sola vez)
+ * y lo abre en una pestaña nueva. La pestaña se abre EN EL CLIC (antes de esperar al servidor) para que Safari no la
+ * bloquee; se le quita el acceso a esta ventana (`opener = null`, lo mismo que «noopener»). Si el navegador la bloquea,
+ * se muestra el enlace para abrirlo a mano.
+ */
+export default function PortadasPage({ item }: { item: MenuItem }) {
+  const { puede } = usePermisos();
+  const { datos: estado, error } = useLectura<Estado>("/api/portadas/estado");
+  const [enlace, setEnlace] = useState<string | null>(null);
+  const puedeAbrir = puede(NODO_PORTADAS, "crear");
+
+  const abrir = async () => {
+    setEnlace(null);
+    const pestana = window.open("about:blank", "_blank");
+    if (pestana) pestana.opener = null;
+    try {
+      const { url } = await post<{ url: string }>("/api/portadas/entrar");
+      if (pestana && !pestana.closed) pestana.location.replace(url);
+      else setEnlace(url);
+    } catch (e) {
+      pestana?.close();
+      avisar.error(e, "No se pudo abrir Portadas. Inténtalo de nuevo.");
+    }
+  };
+
+  return (
+    <AppShell title={item.label} subtitle={item.description}>
+      <PageTransition>
+        {error ? (
+          <Aviso tono="peligro">{error.message}</Aviso>
+        ) : !estado ? (
+          <Tarjeta><Esqueleto className="h-28 w-full" /></Tarjeta>
+        ) : !estado.conectado ? (
+          <Tarjeta>
+            <EmptyState icon={PlugZap} accent={item.accent} title="Portadas aún no está conectado" text={NO_CONECTADO} />
+          </Tarjeta>
+        ) : (
+          <Tarjeta titulo="Gancho" subtitulo="Se abre en una pestaña nueva con tu cuenta del ERP; no necesitas otra contraseña." subtituloVisible>
+            <p className="max-w-2xl text-[14px] text-fg-muted">
+              Gancho crea portadas, títulos y descripciones para YouTube, TikTok, Instagram, Facebook y Prisma Plus a partir de tus episodios.
+            </p>
+            {puedeAbrir ? (
+              <div className="mt-5 flex flex-wrap items-center gap-3">
+                <Boton variante="primario" icono={ExternalLink} onClick={abrir}>Abrir Portadas</Boton>
+                {enlace && (
+                  <span className="text-[13px] text-fg-muted">
+                    Tu navegador bloqueó la pestaña nueva.{" "}
+                    <a href={enlace} target="_blank" rel="noopener noreferrer" className="font-medium text-fg underline" onClick={() => setEnlace(null)}>
+                      Abrir Portadas aquí
+                    </a>{" "}
+                    (el enlace vale 90 segundos y una sola vez).
+                  </span>
+                )}
+              </div>
+            ) : (
+              <Aviso tono="info" className="mt-5">Tu rol puede ver esta sección pero no abrir Gancho. Pide a Luis el permiso «Crear» en Portadas (Gancho).</Aviso>
+            )}
+          </Tarjeta>
+        )}
+      </PageTransition>
+    </AppShell>
+  );
+}
