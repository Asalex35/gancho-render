+/** Nodo del árbol de permisos (server/src/modules/portadas/permisos.ts) y ruta de la pantalla. */
+export const NODO_PORTADAS = "portadas";
+export const RUTA_PORTADAS = "/portadas";
+
+/** Entrada del menú: Social Media › Portadas (con los colores de Social Media). */
+export const PORTADAS: MenuItem = {
+  label: "Portadas",
+  path: RUTA_PORTADAS,
+  icon: Images,
+  accent: "#ec4899",
+  gradient: "linear-gradient(135deg, #f9ce34 0%, #ee2a7b 50%, #6228d7 100%)",
+  description: "Portadas, títulos y descripciones con Gancho para YouTube, TikTok, Instagram, Facebook y Prisma Plus.",
+  nodo: NODO_PORTADAS,
+};
