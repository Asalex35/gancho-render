# Copia este archivo como .env (local) o pon estas variables en Render > Environment.

# --- Obligatorias ---
DATABASE_URL=postgres://localhost/gancho
ANTHROPIC_API_KEY=
NANOBANANA_API_KEY=
SESSION_SECRET=                       # 64 caracteres al azar: openssl rand -hex 32
ADMIN_USER=carlos                     # primer administrador (solo se crea si no existe)
ADMIN_PASSWORD=                       # mínimo 10 caracteres
PUBLIC_BASE_URL=https://gancho.tudominio.com

# --- Respaldo de imágenes (si Nano Banana se cae o se queda sin créditos) ---
GOOGLE_API_KEY=                       # Google AI Studio: el Nano Banana oficial, directo de Google
FAL_KEY=                              # fal.ai: Seedream 4 (otra marca, por si Google también falla)
IMAGE_PROVIDERS=nanobanana,google,fal # orden de uso; solo se usan los que tengan clave

# --- Almacenamiento de imágenes (recomendado: Cloudflare R2) ---
# Sin esto se guardan en disco (DATA_DIR). Con R2 puedes tener varias instancias.
S3_BUCKET=
S3_ENDPOINT=                          # R2: https://<cuenta>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DATA_DIR=./data

# --- Flujo automático (del video a la portada) ---
# Transcripción del audio. Groq es lo más barato y rápido (también sirve OpenAI cambiando la URL).
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-large-v3-turbo
NOTIFY_WEBHOOK_URL=                   # aviso general si un canal no tiene su propio webhook
VIDEO_RETENTION_DAYS=7                # días que se guarda el video original
VIDEO_CONCURRENCY=2                   # videos procesándose a la vez por worker

# --- Escala y gasto ---
ROLE=all                              # all | web | worker
CLAUDE_CONCURRENCY=4                  # llamadas a Claude en paralelo por worker
IMAGE_CONCURRENCY=6                   # imágenes en paralelo por worker
IMAGE_RESOLUTION=1K                   # 1K alcanza para YouTube y gasta menos créditos
CREDITS_PER_IMAGE=8                   # para estimar el gasto de cada lote
DAILY_IMAGE_LIMIT=700                 # portadas por persona al día (un lote de 200 = 600)
ORG_DAILY_IMAGE_LIMIT=3000            # portadas del equipo al día
MAX_EPISODES_PER_BATCH=200
CALLBACK_SECRET=                      # al azar (Nano Banana Pro)

# --- Solo pruebas ---
NANOBANANA_MOCK=0                     # 1 = imágenes falsas, no gasta créditos (no funciona en producción)
NODE_ENV=production
