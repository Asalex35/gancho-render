# Copia este archivo como .env (local) o pon estas variables en Render > Environment.

# --- Obligatorias ---
DATABASE_URL=postgres://localhost/gancho
ANTHROPIC_API_KEY=
NANOBANANA_API_KEY=
SESSION_SECRET=                       # 64 caracteres al azar: openssl rand -hex 32
ADMIN_USER=carlos                     # primer administrador (solo se crea si no existe)
ADMIN_PASSWORD=                       # mínimo 10 caracteres
PUBLIC_BASE_URL=https://gancho.tudominio.com

# --- Almacenamiento de imágenes (recomendado: Cloudflare R2) ---
# Sin esto se guardan en disco (DATA_DIR). Con R2 puedes tener varias instancias.
S3_BUCKET=
S3_ENDPOINT=                          # R2: https://<cuenta>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DATA_DIR=./data

# --- Escala y gasto ---
ROLE=all                              # all | web | worker
CLAUDE_CONCURRENCY=4                  # llamadas a Claude en paralelo por worker
IMAGE_CONCURRENCY=6                   # imágenes en paralelo por worker
IMAGE_RESOLUTION=1K                   # 1K alcanza para YouTube y gasta menos créditos
CREDITS_PER_IMAGE=8                   # para estimar el gasto de cada lote
DAILY_IMAGE_LIMIT=150                 # portadas por persona al día
ORG_DAILY_IMAGE_LIMIT=1500            # portadas del equipo al día
MAX_EPISODES_PER_BATCH=200
CALLBACK_SECRET=                      # al azar (Nano Banana Pro)

# --- Solo pruebas ---
NANOBANANA_MOCK=0                     # 1 = imágenes falsas, no gasta créditos (no funciona en producción)
NODE_ENV=production
