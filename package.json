    "archiver": "^8.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.4.0",
    "onnxruntime-node": "^1.30.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.35.5": true,
    "onnxruntime-node@1.30.0": true
